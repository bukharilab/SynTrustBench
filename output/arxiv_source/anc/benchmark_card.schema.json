{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynTrustBench v0.1.0 benchmark card",
  "type": "object",
  "required": ["benchmark", "submission", "system", "data", "evaluation", "evidence", "evaluability", "limitations", "review"],
  "properties": {
    "benchmark": {
      "type": "object",
      "required": ["name", "version", "track"],
      "properties": {
        "name": {"const": "SynTrustBench"},
        "version": {"const": "0.1.0"},
        "track": {"enum": ["evidence-audit", "controlled-execution"]}
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["report_id", "citation", "primary_source_url", "artifact_url", "intended_use", "prohibited_uses"],
      "properties": {
        "report_id": {"type": "string"},
        "citation": {"type": "string"},
        "primary_source_url": {"type": "string"},
        "artifact_url": {"type": "string"},
        "intended_use": {"type": "string"},
        "prohibited_uses": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "required": ["name", "version_or_commit", "architecture_family", "generated_unit", "conditioning_information"],
      "properties": {
        "name": {"type": "string"},
        "version_or_commit": {"type": "string"},
        "architecture_family": {"type": "string"},
        "generated_unit": {"type": "string"},
        "conditioning_information": {"type": "string"}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["dataset", "dataset_version", "cohort_definition", "preprocessing_version", "split_hash", "governance_constraints"],
      "properties": {
        "dataset": {"type": "string"},
        "dataset_version": {"type": "string"},
        "cohort_definition": {"type": "string"},
        "preprocessing_version": {"type": "string"},
        "split_hash": {"type": "string"},
        "governance_constraints": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["code_commit", "environment", "seeds", "uncertainty_method", "missing_or_failed_runs"],
      "properties": {
        "code_commit": {"type": "string"},
        "environment": {"type": "string"},
        "seeds": {"type": "array", "items": {"type": ["integer", "string"]}},
        "uncertainty_method": {"type": "string"},
        "missing_or_failed_runs": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["fidelity", "utility_and_validity", "privacy", "equity", "robustness"],
      "properties": {
        "fidelity": {"$ref": "#/$defs/fidelity"},
        "utility_and_validity": {"$ref": "#/$defs/utility"},
        "privacy": {"$ref": "#/$defs/privacy"},
        "equity": {"$ref": "#/$defs/equity"},
        "robustness": {"$ref": "#/$defs/robustness"}
      },
      "additionalProperties": false
    },
    "evaluability": {
      "type": "object",
      "required": ["gate", "missing_fields", "reproduction_notes"],
      "properties": {
        "gate": {"enum": ["Pass", "Conditional", "Fail", ""]},
        "missing_fields": {"type": "array", "items": {"type": "string"}},
        "reproduction_notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "review": {
      "type": "object",
      "required": ["primary_coder", "independent_coder", "adjudicator", "date", "unresolved_conflicts"],
      "properties": {
        "primary_coder": {"type": "string"},
        "independent_coder": {"type": "string"},
        "adjudicator": {"type": "string"},
        "date": {"type": "string"},
        "unresolved_conflicts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "maturity": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "fidelity": {
      "type": "object",
      "required": ["maturity", "evidence_locator", "metrics", "rare_pattern_analysis", "failure_flags"],
      "properties": {
        "maturity": {"$ref": "#/$defs/maturity"},
        "evidence_locator": {"type": "string"},
        "metrics": {"$ref": "#/$defs/stringArray"},
        "rare_pattern_analysis": {"type": "string"},
        "failure_flags": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "utility": {
      "type": "object",
      "required": ["maturity", "evidence_locator", "tasks", "metrics", "real_held_out_test", "calibration", "clinical_review", "safety_failure", "failure_flags"],
      "properties": {
        "maturity": {"$ref": "#/$defs/maturity"},
        "evidence_locator": {"type": "string"},
        "tasks": {"$ref": "#/$defs/stringArray"},
        "metrics": {"$ref": "#/$defs/stringArray"},
        "real_held_out_test": {"type": "string"},
        "calibration": {"type": "string"},
        "clinical_review": {"type": "string"},
        "safety_failure": {"type": "boolean"},
        "failure_flags": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["maturity", "evidence_locator", "attacker_access", "auxiliary_knowledge", "target_population", "member_nonmember_design", "attack_training_and_calibration", "attacks", "operating_points", "subgroup_or_rarity_results", "private_data_reaccess", "dp_claimed", "formal_dp", "dp_claim_status", "unit_of_privacy", "adjacency_relation", "mechanism", "clipping_norm", "noise_multiplier", "sampling_scheme", "sample_rate", "steps_or_epochs", "epsilon", "delta", "accountant", "accountant_version", "implementation_version", "tuning_or_selection_privacy_cost", "failure_flags"],
      "properties": {
        "maturity": {"$ref": "#/$defs/maturity"},
        "evidence_locator": {"type": "string"},
        "attacker_access": {"type": "string"},
        "auxiliary_knowledge": {"type": "string"},
        "target_population": {"type": "string"},
        "member_nonmember_design": {"type": "string"},
        "attack_training_and_calibration": {"type": "string"},
        "attacks": {"$ref": "#/$defs/stringArray"},
        "operating_points": {"$ref": "#/$defs/stringArray"},
        "subgroup_or_rarity_results": {"type": "string"},
        "private_data_reaccess": {"type": "string"},
        "dp_claimed": {"type": "boolean"},
        "formal_dp": {"type": "boolean"},
        "dp_claim_status": {"enum": ["complete", "incomplete", "not a DP claim", ""]},
        "unit_of_privacy": {"type": "string"},
        "adjacency_relation": {"type": "string"},
        "mechanism": {"type": "string"},
        "clipping_norm": {"type": ["number", "null"]},
        "noise_multiplier": {"type": ["number", "null"]},
        "sampling_scheme": {"type": "string"},
        "sample_rate": {"type": ["number", "null"]},
        "steps_or_epochs": {"type": "string"},
        "epsilon": {"type": ["number", "null"]},
        "delta": {"type": ["number", "null"]},
        "accountant": {"type": "string"},
        "accountant_version": {"type": "string"},
        "implementation_version": {"type": "string"},
        "tuning_or_selection_privacy_cost": {"type": "string"},
        "failure_flags": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "equity": {
      "type": "object",
      "required": ["maturity", "evidence_locator", "subgroup_definitions", "subgroup_denominators", "metrics", "uncertainty", "failure_flags"],
      "properties": {
        "maturity": {"$ref": "#/$defs/maturity"},
        "evidence_locator": {"type": "string"},
        "subgroup_definitions": {"$ref": "#/$defs/stringArray"},
        "subgroup_denominators": {"type": "string"},
        "metrics": {"$ref": "#/$defs/stringArray"},
        "uncertainty": {"type": "string"},
        "failure_flags": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "robustness": {
      "type": "object",
      "required": ["maturity", "evidence_locator", "stressors", "external_or_temporal_validation", "metrics", "failure_flags"],
      "properties": {
        "maturity": {"$ref": "#/$defs/maturity"},
        "evidence_locator": {"type": "string"},
        "stressors": {"$ref": "#/$defs/stringArray"},
        "external_or_temporal_validation": {"type": "string"},
        "metrics": {"$ref": "#/$defs/stringArray"},
        "failure_flags": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
