{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynTrustBench v0.1.0 study annotation row",
  "description": "One source-audited report in the frozen pilot corpus.",
  "type": "object",
  "required": [
    "report_id",
    "citation_key",
    "title",
    "first_author",
    "year",
    "venue",
    "publication_type",
    "peer_reviewed",
    "primary_source_url",
    "doi_or_identifier",
    "modality",
    "task_scope",
    "evaluated_systems",
    "architecture_family",
    "model_name",
    "dataset_names",
    "dataset_versions",
    "data_access",
    "code_available",
    "code_url",
    "fidelity_evaluated",
    "fidelity_metrics",
    "clinical_validity_evaluated",
    "clinical_validity_method",
    "utility_evaluated",
    "utility_metrics",
    "held_out_real_test",
    "privacy_evaluated",
    "privacy_test_type",
    "threat_model",
    "membership_inference",
    "attribute_inference",
    "reidentification_or_reconstruction",
    "dp_claimed",
    "formal_dp_verified",
    "dp_evidence_status",
    "dp_mechanism",
    "epsilon_reported",
    "epsilon_values",
    "delta_reported",
    "delta_values",
    "fairness_evaluated",
    "protected_attributes",
    "subgroup_metrics",
    "robustness_evaluated",
    "external_validation",
    "seeds_or_repeats",
    "uncertainty_reported",
    "fidelity_maturity",
    "utility_maturity",
    "privacy_maturity",
    "equity_maturity",
    "robustness_maturity",
    "evaluability_gate",
    "verification_status",
    "verifier",
    "verified_date",
    "evidence_notes",
    "ambiguity_flag",
    "eligibility_status",
    "exclusion_reason",
    "mimic_iii_used"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^STB-[0-9]{3}$"
    },
    "citation_key": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "first_author": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 2018,
      "maximum": 2026
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "publication_type": {
      "enum": [
        "Journal article",
        "Conference paper",
        "Workshop paper",
        "Preprint",
        "Thesis",
        "Other"
      ]
    },
    "peer_reviewed": {
      "enum": [
        "Yes",
        "No",
        "Unclear"
      ]
    },
    "primary_source_url": {
      "type": "string",
      "format": "uri"
    },
    "doi_or_identifier": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "enum": [
        "Tabular EHR",
        "Clinical time series",
        "Medical imaging",
        "Clinical text",
        "Multimodal/other"
      ]
    },
    "task_scope": {
      "enum": [
        "Generator",
        "Generator plus benchmark",
        "Benchmark/evaluation framework",
        "Augmentation",
        "Translation/reconstruction",
        "Other"
      ]
    },
    "evaluated_systems": {
      "type": "string",
      "minLength": 1
    },
    "architecture_family": {
      "enum": [
        "GAN",
        "Diffusion",
        "LLM",
        "VAE",
        "Hybrid/other",
        "Kernel/marginal/other",
        "Evaluation framework"
      ]
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "dataset_names": {
      "type": "string",
      "minLength": 1
    },
    "dataset_versions": {
      "type": "string",
      "minLength": 1
    },
    "data_access": {
      "enum": [
        "Public",
        "Credentialed",
        "Private",
        "Mixed",
        "NR"
      ]
    },
    "code_available": {
      "enum": [
        "Yes",
        "No",
        "NR"
      ]
    },
    "code_url": {
      "type": "string",
      "minLength": 1
    },
    "fidelity_evaluated": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "fidelity_metrics": {
      "type": "string",
      "minLength": 1
    },
    "clinical_validity_evaluated": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "clinical_validity_method": {
      "type": "string",
      "minLength": 1
    },
    "utility_evaluated": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "utility_metrics": {
      "type": "string",
      "minLength": 1
    },
    "held_out_real_test": {
      "enum": [
        "Yes",
        "No",
        "Unclear"
      ]
    },
    "privacy_evaluated": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "privacy_test_type": {
      "type": "string",
      "minLength": 1
    },
    "threat_model": {
      "type": "string",
      "minLength": 1
    },
    "membership_inference": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "attribute_inference": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "reidentification_or_reconstruction": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "dp_claimed": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "formal_dp_verified": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "dp_evidence_status": {
      "enum": [
        "Complete",
        "Incomplete",
        "Not a DP claim"
      ]
    },
    "dp_mechanism": {
      "type": "string",
      "minLength": 1
    },
    "epsilon_reported": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "epsilon_values": {
      "type": "string",
      "minLength": 1
    },
    "delta_reported": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "delta_values": {
      "type": "string",
      "minLength": 1
    },
    "fairness_evaluated": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "protected_attributes": {
      "type": "string",
      "minLength": 1
    },
    "subgroup_metrics": {
      "type": "string",
      "minLength": 1
    },
    "robustness_evaluated": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "external_validation": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "seeds_or_repeats": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty_reported": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "fidelity_maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "utility_maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "privacy_maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "equity_maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "robustness_maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "evaluability_gate": {
      "enum": [
        "Pass",
        "Conditional",
        "Fail"
      ]
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "verifier": {
      "type": "string",
      "minLength": 1
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_notes": {
      "type": "string",
      "minLength": 1
    },
    "ambiguity_flag": {
      "enum": [
        "Yes",
        "No"
      ]
    },
    "eligibility_status": {
      "enum": [
        "Included",
        "Context-only",
        "Excluded"
      ]
    },
    "exclusion_reason": {
      "type": "string",
      "minLength": 1
    },
    "mimic_iii_used": {
      "enum": [
        "Yes",
        "No"
      ]
    }
  },
  "additionalProperties": false
}
